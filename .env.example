# =============================================================================
# CodeLab Core Service - Development Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelab
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis-secure-password-change-in-production
REDIS_DB=0
REDIS_URL=redis://:redis-secure-password-change-in-production@redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# QDRANT CONFIGURATION (Vector Database)
# =============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# =============================================================================
# MINIO CONFIGURATION (S3-compatible storage)
# =============================================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=langfuse
MINIO_REGION=auto

# =============================================================================
# CLICKHOUSE CONFIGURATION
# =============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# =============================================================================
# LANGFUSE CONFIGURATION
# =============================================================================
# NextAuth configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=langfuse-secret-change-me-in-production
SALT=langfuse-salt-change-me-in-production
ENCRYPTION_KEY=bf5672b1950e122c1b797146af33a32cd3c794615c8bb27ef5315cf38101aa1b

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langfuse

# LiteLLM integration
LITELLM_BASE_URL=http://litellm:4000

# API Keys
LANGFUSE_PUBLIC_KEY=pk_defaultkey
LANGFUSE_SECRET_KEY=sk_defaultsecret

# Langfuse ports
LANGFUSE_WEB_PORT=3001
LANGFUSE_WORKER_PORT=3030

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================
LITELLM_MASTER_KEY=super-secret-key-change-in-production
LITELLM_PORT=4000

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================
# Database
APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/codelab

# Redis
APP_REDIS_URL=redis://redis:6379/0

# Services
QDRANT_URL=http://qdrant:6333
LITELLM_URL=http://litellm:4000
LANGFUSE_HOST=http://langfuse-web:3000

# Langfuse SDK Configuration (for tracing)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk_lf_...
LANGFUSE_SECRET_KEY=sk_lf_...
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_DEBUG=false

# Tracing
OTLP_EXPORTER_URL=http://jaeger:4318

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=14268

# =============================================================================
# EVENT CONSUMER CONFIGURATION (Redis Streams)
# =============================================================================
# Enable/disable event consumer for user sync
USE_EVENT_CONSUMER=true

# Redis Streams configuration
EVENTS_STREAM_KEY=user_events
EVENTS_CONSUMER_GROUP=core_service_consumer_group
EVENTS_CONSUMER_NAME=core_service_consumer_1

# Event processing configuration
EVENTS_BATCH_SIZE=10
EVENTS_CONSUMER_TIMEOUT=1000

# Retry policy for failed events
EVENTS_MAX_RETRIES=3
EVENTS_RETRY_BACKOFF_BASE=1
EVENTS_DLQ_STREAM_KEY=user_events_dlq

# Token Blacklist Configuration (for middleware)
USE_TOKEN_BLACKLIST=true
TOKEN_BLACKLIST_MIN_TTL=3600

# Event versioning
EVENTS_VERSION=1.0

# =============================================================================
# FEATURES & TELEMETRY
# =============================================================================
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================
# Uncomment for development
# RELOAD=true
# DEBUG=true
