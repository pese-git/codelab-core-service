# =============================================================================
# CodeLab Core Service - Development Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
CORE_SERVICE_POSTGRES_USER=postgres
CORE_SERVICE_POSTGRES_PASSWORD=postgres
CORE_SERVICE_POSTGRES_DB=codelab
CORE_SERVICE_POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
CORE_SERVICE_REDIS_HOST=redis
CORE_SERVICE_REDIS_PORT=6379
CORE_SERVICE_REDIS_PASSWORD=redis-secure-password-change-in-production
CORE_SERVICE_REDIS_DB=0
CORE_SERVICE_REDIS_URL=redis://:redis-secure-password-change-in-production@redis:6379/0
CORE_SERVICE_REDIS_MAX_CONNECTIONS=50
CORE_SERVICE_REDIS_SOCKET_TIMEOUT=5
CORE_SERVICE_REDIS_SOCKET_CONNECT_TIMEOUT=5

# =============================================================================
# QDRANT CONFIGURATION (Vector Database)
# =============================================================================
CORE_SERVICE_QDRANT_HOST=qdrant
CORE_SERVICE_QDRANT_PORT=6333
CORE_SERVICE_QDRANT_GRPC_PORT=6334
CORE_SERVICE_QDRANT_API_KEY=

# =============================================================================
# MINIO CONFIGURATION (S3-compatible storage)
# =============================================================================
CORE_SERVICE_MINIO_ROOT_USER=minio
CORE_SERVICE_MINIO_ROOT_PASSWORD=miniosecret
CORE_SERVICE_MINIO_HOST=minio
CORE_SERVICE_MINIO_PORT=9000
CORE_SERVICE_MINIO_CONSOLE_PORT=9001
CORE_SERVICE_MINIO_BUCKET=langfuse
CORE_SERVICE_MINIO_REGION=auto

# =============================================================================
# CLICKHOUSE CONFIGURATION
# =============================================================================
CORE_SERVICE_CLICKHOUSE_HOST=clickhouse
CORE_SERVICE_CLICKHOUSE_PORT=8123
CORE_SERVICE_CLICKHOUSE_NATIVE_PORT=9000
CORE_SERVICE_CLICKHOUSE_DB=langfuse
CORE_SERVICE_CLICKHOUSE_USER=clickhouse
CORE_SERVICE_CLICKHOUSE_PASSWORD=clickhouse

# =============================================================================
# LANGFUSE CONFIGURATION
# =============================================================================
# NextAuth configuration
CORE_SERVICE_NEXTAUTH_URL=http://localhost:3001
CORE_SERVICE_NEXTAUTH_SECRET=langfuse-secret-change-me-in-production
CORE_SERVICE_SALT=langfuse-salt-change-me-in-production
CORE_SERVICE_ENCRYPTION_KEY=bf5672b1950e122c1b797146af33a32cd3c794615c8bb27ef5315cf38101aa1b

# Database
CORE_SERVICE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/langfuse

# LiteLLM integration
CORE_SERVICE_LITELLM_BASE_URL=http://litellm:4000

# API Keys
CORE_SERVICE_LANGFUSE_PUBLIC_KEY=pk_defaultkey
CORE_SERVICE_LANGFUSE_SECRET_KEY=sk_defaultsecret

# Langfuse ports
CORE_SERVICE_LANGFUSE_WEB_PORT=3001
CORE_SERVICE_LANGFUSE_WORKER_PORT=3030

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================
CORE_SERVICE_LITELLM_MASTER_KEY=super-secret-key-change-in-production
CORE_SERVICE_LITELLM_PORT=4000

# =============================================================================
# CORE APPLICATION CONFIGURATION
# =============================================================================
# Database
CORE_SERVICE_APP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/codelab

# Redis
CORE_SERVICE_APP_REDIS_URL=redis://redis:6379/0

# Services
CORE_SERVICE_QDRANT_URL=http://qdrant:6333
CORE_SERVICE_LITELLM_URL=http://litellm:4000
CORE_SERVICE_LANGFUSE_HOST=http://langfuse-web:3000

# Langfuse SDK Configuration (for tracing)
CORE_SERVICE_LANGFUSE_ENABLED=true
CORE_SERVICE_LANGFUSE_PUBLIC_KEY=pk_lf_...
CORE_SERVICE_LANGFUSE_SECRET_KEY=sk_lf_...
CORE_SERVICE_LANGFUSE_HOST=http://langfuse-web:3000
CORE_SERVICE_LANGFUSE_DEBUG=false

# Tracing
CORE_SERVICE_OTLP_EXPORTER_URL=http://jaeger:4318

# Application settings
CORE_SERVICE_APP_HOST=0.0.0.0
CORE_SERVICE_APP_PORT=8000
CORE_SERVICE_PYTHONUNBUFFERED=1
CORE_SERVICE_LOG_LEVEL=INFO

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus
CORE_SERVICE_PROMETHEUS_PORT=9090

# Grafana
CORE_SERVICE_GRAFANA_PORT=3000
CORE_SERVICE_GRAFANA_ADMIN_USER=admin
CORE_SERVICE_GRAFANA_ADMIN_PASSWORD=admin
CORE_SERVICE_GF_USERS_ALLOW_SIGN_UP=false
CORE_SERVICE_GF_AUTH_ANONYMOUS_ENABLED=false

# Jaeger
CORE_SERVICE_JAEGER_UI_PORT=16686
CORE_SERVICE_JAEGER_OTLP_HTTP_PORT=14268

# =============================================================================
# EVENT CONSUMER CONFIGURATION (Redis Streams)
# =============================================================================
# Enable/disable event consumer for user sync
CORE_SERVICE_USE_EVENT_CONSUMER=true

# Redis Streams configuration
CORE_SERVICE_EVENTS_STREAM_KEY=user_events
CORE_SERVICE_EVENTS_CONSUMER_GROUP=core_service_consumer_group
CORE_SERVICE_EVENTS_CONSUMER_NAME=core_service_consumer_1

# Event processing configuration
CORE_SERVICE_EVENTS_BATCH_SIZE=10
CORE_SERVICE_EVENTS_CONSUMER_TIMEOUT=1000

# Retry policy for failed events
CORE_SERVICE_EVENTS_MAX_RETRIES=3
CORE_SERVICE_EVENTS_RETRY_BACKOFF_BASE=1
CORE_SERVICE_EVENTS_DLQ_STREAM_KEY=user_events_dlq

# Token Blacklist Configuration (for middleware)
CORE_SERVICE_USE_TOKEN_BLACKLIST=true
CORE_SERVICE_TOKEN_BLACKLIST_MIN_TTL=3600

# Event versioning
CORE_SERVICE_EVENTS_VERSION=1.0

# =============================================================================
# FEATURES & TELEMETRY
# =============================================================================
CORE_SERVICE_TELEMETRY_ENABLED=false
CORE_SERVICE_LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================
# Uncomment for development
# CORE_SERVICE_RELOAD=true
# CORE_SERVICE_DEBUG=true
