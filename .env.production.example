# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in the values for your environment

# =============================================================================
# Database Configuration
# =============================================================================
CORE_SERVICE_POSTGRES_USER=postgres
CORE_SERVICE_POSTGRES_PASSWORD=change-me-secure-password-min-32-chars-required
CORE_SERVICE_POSTGRES_DB=codelab
CORE_SERVICE_POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
CORE_SERVICE_REDIS_HOST=redis
CORE_SERVICE_REDIS_PORT=6379
CORE_SERVICE_REDIS_PASSWORD=change-me-redis-secure-password-min-32-chars
# Format for connection: redis://:password@host:port/db

# =============================================================================
# Qdrant Configuration
# =============================================================================
CORE_SERVICE_QDRANT_URL=http://qdrant:6333
CORE_SERVICE_QDRANT_REST_PORT=6333
CORE_SERVICE_QDRANT_GRPC_PORT=6334

# =============================================================================
# MinIO Configuration
# =============================================================================
CORE_SERVICE_MINIO_ROOT_USER=minio-admin
CORE_SERVICE_MINIO_ROOT_PASSWORD=change-me-minio-secure-password-min-32-chars
CORE_SERVICE_MINIO_API_PORT=9000
CORE_SERVICE_MINIO_CONSOLE_PORT=9001

# =============================================================================
# ClickHouse Configuration
# =============================================================================
CORE_SERVICE_CLICKHOUSE_DB=langfuse
CORE_SERVICE_CLICKHOUSE_USER=clickhouse
CORE_SERVICE_CLICKHOUSE_PASSWORD=change-me-clickhouse-secure-password-min-32-chars
CORE_SERVICE_CLICKHOUSE_HTTP_PORT=8123
CORE_SERVICE_CLICKHOUSE_NATIVE_PORT=9000

# =============================================================================
# Langfuse Configuration
# =============================================================================
CORE_SERVICE_NEXTAUTH_URL=https://your-domain.com:3001
CORE_SERVICE_NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars-required
CORE_SERVICE_SALT=change-me-salt-value-min-32-chars
CORE_SERVICE_ENCRYPTION_KEY=change-me-encryption-key-must-be-64-char-hex-string

CORE_SERVICE_LANGFUSE_WORKER_PORT=3030
CORE_SERVICE_LANGFUSE_WEB_PORT=3001

# S3/MinIO Endpoints
CORE_SERVICE_LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
CORE_SERVICE_LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
CORE_SERVICE_LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

CORE_SERVICE_LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
CORE_SERVICE_LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
CORE_SERVICE_LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

CORE_SERVICE_LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
CORE_SERVICE_LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
CORE_SERVICE_LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/

# Initial Langfuse Admin User (only for first run)
CORE_SERVICE_LANGFUSE_INIT_USER_EMAIL=admin@your-domain.com
CORE_SERVICE_LANGFUSE_INIT_USER_NAME=Administrator
CORE_SERVICE_LANGFUSE_INIT_USER_PASSWORD=change-me-initial-password

# =============================================================================
# LiteLLM Configuration
# =============================================================================
CORE_SERVICE_LITELLM_MASTER_KEY=change-me-litellm-master-key-min-32-chars
CORE_SERVICE_LITELLM_PORT=4000

# =============================================================================
# Monitoring Configuration
# =============================================================================
CORE_SERVICE_PROMETHEUS_PORT=9090
CORE_SERVICE_GRAFANA_PORT=3000
CORE_SERVICE_GRAFANA_ADMIN_USER=admin
CORE_SERVICE_GRAFANA_ADMIN_PASSWORD=change-me-grafana-password-min-32-chars
CORE_SERVICE_JAEGER_UI_PORT=16686
CORE_SERVICE_JAEGER_OTLP_HTTP_PORT=14268

# =============================================================================
# Core Application Configuration
# =============================================================================
CORE_SERVICE_APP_PORT=8000
CORE_SERVICE_LOG_LEVEL=INFO

# Database URL for Core Application (using asyncpg)
CORE_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:change-me-secure-password-min-32-chars@postgres:5432/codelab

# Service URLs
CORE_SERVICE_LITELLM_URL=http://litellm:4000
CORE_SERVICE_OTLP_EXPORTER_URL=http://jaeger:4318
CORE_SERVICE_LANGFUSE_HOST=http://langfuse-web:3000
CORE_SERVICE_LANGFUSE_PUBLIC_KEY=pk_defaultkey
CORE_SERVICE_LANGFUSE_SECRET_KEY=sk_defaultsecret

# =============================================================================
# Security Configuration
# =============================================================================
# CORS Configuration
CORE_SERVICE_CORS_ORIGINS=["https://your-domain.com", "https://www.your-domain.com"]
CORE_SERVICE_CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Feature Flags
# =============================================================================
CORE_SERVICE_TELEMETRY_ENABLED=false
CORE_SERVICE_LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# Backup and Retention Configuration
# =============================================================================
# Prometheus data retention (default: 30d)
CORE_SERVICE_PROMETHEUS_RETENTION=30d

# Log retention
CORE_SERVICE_LOG_RETENTION_DAYS=30

# =============================================================================
# Optional: External Integration Configuration
# =============================================================================
# If you want to integrate with external services, add configuration here
# CORE_SERVICE_SENTRY_DSN=
# CORE_SERVICE_DATADOG_API_KEY=
# CORE_SERVICE_AWS_ACCESS_KEY_ID=
# CORE_SERVICE_AWS_SECRET_ACCESS_KEY=
# CORE_SERVICE_SLACK_WEBHOOK_URL=
