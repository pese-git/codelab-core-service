# =============================================================================
# Production Environment Configuration
# =============================================================================
# Copy this file to .env.production and fill in the values for your environment

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-secure-password-min-32-chars-required
POSTGRES_DB=codelab
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-secure-password-min-32-chars
# Format for connection: redis://:password@host:port/db

# =============================================================================
# Qdrant Configuration
# =============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# =============================================================================
# MinIO Configuration
# =============================================================================
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-secure-password-min-32-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# ClickHouse Configuration
# =============================================================================
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me-clickhouse-secure-password-min-32-chars
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# =============================================================================
# Langfuse Configuration
# =============================================================================
NEXTAUTH_URL=https://your-domain.com:3001
NEXTAUTH_SECRET=change-me-nextauth-secret-min-32-chars-required
SALT=change-me-salt-value-min-32-chars
ENCRYPTION_KEY=change-me-encryption-key-must-be-64-char-hex-string

LANGFUSE_WORKER_PORT=3030
LANGFUSE_WEB_PORT=3001

# S3/MinIO Endpoints
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/

LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://minio:9000
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/

# Initial Langfuse Admin User (only for first run)
LANGFUSE_INIT_USER_EMAIL=admin@your-domain.com
LANGFUSE_INIT_USER_NAME=Administrator
LANGFUSE_INIT_USER_PASSWORD=change-me-initial-password

# =============================================================================
# LiteLLM Configuration
# =============================================================================
LITELLM_MASTER_KEY=change-me-litellm-master-key-min-32-chars
LITELLM_PORT=4000

# =============================================================================
# Monitoring Configuration
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password-min-32-chars
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=14268

# =============================================================================
# Core Application Configuration
# =============================================================================
APP_PORT=8000
LOG_LEVEL=INFO

# Database URL for Core Application (using asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:change-me-secure-password-min-32-chars@postgres:5432/codelab

# Service URLs
LITELLM_URL=http://litellm:4000
OTLP_EXPORTER_URL=http://jaeger:4318
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=pk_defaultkey
LANGFUSE_SECRET_KEY=sk_defaultsecret

# =============================================================================
# Security Configuration
# =============================================================================
# CORS Configuration
CORS_ORIGINS=["https://your-domain.com", "https://www.your-domain.com"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Feature Flags
# =============================================================================
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# =============================================================================
# Backup and Retention Configuration
# =============================================================================
# Prometheus data retention (default: 30d)
PROMETHEUS_RETENTION=30d

# Log retention
LOG_RETENTION_DAYS=30

# =============================================================================
# Optional: External Integration Configuration
# =============================================================================
# If you want to integrate with external services, add configuration here
# SENTRY_DSN=
# DATADOG_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SLACK_WEBHOOK_URL=
